# ============================================================
# Terraform
# ============================================================

**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json

override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraformrc
terraform.rc

# Keep Terraform dependency lock files in Git
!.terraform.lock.hcl


# ============================================================
# Terraform plans
# ============================================================

*.tfplan
*.plan


# ============================================================
# Infracost
# ============================================================

.infracost/
infracost.json
infracost-*.json
infracost-*.html


# ============================================================
# Generated reports
# ============================================================

reports/**/*.json
reports/**/*.csv
reports/**/*.html
reports/**/*.log
reports/**/*.txt

# Preserve report directory structure
!reports/**/.gitkeep

# Markdown reports may be intentionally committed as evidence
!reports/**/*.md

# Curated sanitized remediation evidence may be committed
!reports/remediation/aws/execution-evidence.json
!reports/remediation/azure/execution-evidence.json
!reports/remediation/cross-cloud-remediation-summary.json


# ============================================================
# AWS local files / credentials
# ============================================================

.aws/
credentials
aws_credentials


# ============================================================
# Azure local files / credentials
# ============================================================

.azure/
azureProfile.json


# ============================================================
# Environment variables and secrets
# ============================================================

.env
.env.*
!.env.example

*.pem
*.key
*.pfx
*.p12

secrets/
secret/
*.secret


